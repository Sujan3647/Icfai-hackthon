# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ideathon?retryWrites=true&w=majority

# Google OAuth (Optional - only needed if using authentication)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Secret (Optional - only needed if using authentication)
JWT_SECRET=your_jwt_secret_key

# Note: For Vercel deployment, add these environment variables in your Vercel project settings
# Dashboard > Project > Settings > Environment Variables
