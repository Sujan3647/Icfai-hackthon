# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Verification API (Optional but Recommended)
# Sign up for free at https://www.zerobounce.net/members/pricing/ (100 free validations/month)
# Without this, the system will use basic validation + pattern detection for fake emails
ZEROBOUNCE_API_KEY=your_zerobounce_api_key
